# Copia este archivo a `.env` y complétalo. `.env` está en .gitignore: nunca se sube.
#
# Usa una CUENTA DE SERVICIO de solo lectura, no credenciales personales.
# Si el robot corre con la cuenta de una persona, el día que esa persona cambie
# su contraseña la automatización se cae en silencio, y cualquier acción queda
# registrada en GLPI a su nombre.

GLPI_URL=https://www.seti.co/glpi
GLPI_USER=
GLPI_PASSWORD=

# Texto por el que se reconoce la entidad en GLPI. La sonda lo usa para probar
# si se puede filtrar en origen en vez de descargar todos los clientes.
# Las comillas importan: sin ellas el espacio parte el valor en dos.
GLPI_ENTIDAD="ACCION FIDUCIARIA"
