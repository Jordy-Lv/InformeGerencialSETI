# Copiar este archivo a ".env" en la misma carpeta y completar los valores reales.
# ".env" NUNCA se sube al repositorio ni se comparte por chat/correo sin cifrar.

# --- GLPI ---
# URL base de la API REST de GLPI, SIN /apirest.php al final.
# Ejemplo: https://glpi.tuempresa.com
GLPI_URL=

# App-Token: se genera en GLPI > Configuración > General > API > "Añadir aplicación cliente API".
GLPI_APP_TOKEN=

# User-Token: se genera en GLPI > Preferencias del usuario de servicio > pestaña "API" > "Generar" token personal.
# Recomendado: crear un usuario de servicio de solo lectura para esto (ver sección 9 de la documentación
# de Acción Fiduciaria: hoy ese proyecto usa credenciales personales como deuda técnica pendiente;
# para Cardio Infantil conviene arrancar ya con un usuario de servicio si es posible).
GLPI_USER_TOKEN=

# Nombre EXACTO de la entidad de Cardio Infantil en GLPI, tal como aparece en el árbol de entidades.
# Déjalo vacío por ahora: la sonda (sonda_glpi.py) te va a listar las entidades reales para que confirmes
# cuál es y lo completes aquí después.
GLPI_ENTIDAD_CARDIO=

# --- Herramienta de monitoreo SQL (pendiente de identificar) ---
# Se completa cuando se confirme qué herramienta usan (Zabbix, SolarWinds, PRTG u otra).
# MONITOREO_URL=
# MONITOREO_API_KEY=

# --- Rutas opcionales (se activan más adelante, no hacen falta para la sonda) ---
# RUTA_ONEDRIVE=
# FORZAR_ONEDRIVE=
