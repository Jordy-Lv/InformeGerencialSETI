# macOS
.DS_Store

# Archivos de bloqueo de Excel/Word (se crean al abrir un documento)
~$*

# Salidas generadas: PDFs del informe, temporales
output/
outputs/
tmp/

# Evidencia de QA: vídeos, capturas y PDFs pesados.
# Se conserva el informe de resultados, que sí es documentación.
qa-report/*
!qa-report/report.md

# Credenciales de GLPI y respuestas crudas del servidor (traen datos de casos
# de todos los clientes). Nunca deben salir del equipo donde se ejecutan.
automatizacion/.env
automatizacion/salida/
__pycache__/

# Insumo generado por la extracción automática (datos de casos)
insumos-af.js

# Insumos manuales con datos reales de casos/alertas del cliente (Excel de
# GLPI, AlertsList, Disponibilidad, Logros). Igual que automatizacion/salida/,
# nunca deben salir del equipo donde se preparan. Cubre "Insumos/" y las
# carpetas mensuales tipo "Insumos - Junio/".
Insumos*/
